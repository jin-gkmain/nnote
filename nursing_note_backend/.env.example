API_PORT=3001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nursing_note
DB_USER=nursing_user
DB_PASSWORD=nursing_pass_1234

# JWT
JWT_SECRET=dev-change-me-in-production
JWT_EXPIRES=7d

# Bootstrap admin (optional)
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=관리자

# STT provider: clova-speech | clova-csr | legacy
STT_PROVIDER=clova-speech
PY_STT_TIMEOUT_MS=180000
STT_LANGUAGE=ko

# CLOVA Speech (recommended for uploaded audio files)
# Use the Secret Key and Invoke URL from CLOVA Speech Builder > Settings > Integration info.
# This is different from CLOVA Studio LLM's CLOVA_API_SECRET_KEY.
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_LANGUAGE=ko-KR
# Optional upload params JSON, e.g. {"completion":"sync","fullText":true}
CLOVA_SPEECH_PARAMS_JSON=

# CLOVA CSR (short-form alternative)
CLOVA_CSR_URL=https://naveropenapi.apigw.ntruss.com/recog/v1/stt
CLOVA_CSR_CLIENT_ID=
CLOVA_CSR_CLIENT_SECRET=
CLOVA_CSR_LANGUAGE=Kor

# Local/legacy STT fallback
# For local backend: http://127.0.0.1:8000/v1/transcribe
# For Docker Compose with --profile local-stt: http://stt:8000/v1/transcribe
PY_STT_API_URL=http://127.0.0.1:8000/v1/transcribe

# CLOVA AI draft (required for AI draft / template_fill)
CLOVA_API_URL=
CLOVA_API_SECRET_KEY=

# Naver OCR (required for OCR)
NAVER_OCR_API_URL=
NAVER_OCR_SECRET_KEY=

# Qdrant autocomplete (optional)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nursing-autocomplete
